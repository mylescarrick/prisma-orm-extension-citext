{
  "name": "prisma-orm-extension-citext",
  "version": "0.0.0",
  "description": "Case-insensitive text (PostgreSQL citext) columns for Prisma 8.",
  "license": "MIT",
  "author": "Myles Carrick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mylescarrick/prisma-orm-extension-citext.git"
  },
  "homepage": "https://github.com/mylescarrick/prisma-orm-extension-citext#readme",
  "bugs": {
    "url": "https://github.com/mylescarrick/prisma-orm-extension-citext/issues"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "bun test test",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "check:pins": "node scripts/check-pins.mjs",
    "build:contract-space": "prisma contract emit",
    "verify:package": "node scripts/verify-package.mjs",
    "e2e": "bash scripts/e2e.sh",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@prisma/orm-family-sql": "8.0.0-rc.14",
    "@prisma/orm-framework": "8.0.0-rc.14",
    "@prisma/orm-toolchain": "8.0.0-rc.14",
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@prisma/orm-target-postgres": "8.0.0-rc.14",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.6.2",
    "@prisma/orm-postgres": "8.0.0-rc.14",
    "@prisma/orm-target-postgres": "8.0.0-rc.14",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "prisma": "8.0.0-rc.14",
    "tsdown": "^0.22.8",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./codec-types": {
      "types": "./dist/codec-types.d.mts",
      "default": "./dist/codec-types.mjs"
    },
    "./column-types": {
      "types": "./dist/column-types.d.mts",
      "default": "./dist/column-types.mjs"
    },
    "./control": {
      "types": "./dist/control.d.mts",
      "default": "./dist/control.mjs"
    },
    "./pack": {
      "types": "./dist/pack.d.mts",
      "default": "./dist/pack.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "prisma",
    "prisma-8",
    "extension",
    "citext",
    "postgres",
    "case-insensitive"
  ],
  "overrides": {
    "@prisma/orm-toolchain": "8.0.0-rc.14",
    "@prisma/orm-framework": "8.0.0-rc.14",
    "@prisma/cli-engine": "0.6.2",
    "arktype": "2.2.6"
  }
}
